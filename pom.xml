<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>motorph</groupId>
    <artifactId>MO-IT153-S4101-Group-8</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- =========================================================
         Project, JaCoCo, and SonarQube Cloud Configuration
         ========================================================= -->
    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <maven.compiler.release>
            23
        </maven.compiler.release>

        <exec.mainClass>
            main.Main
        </exec.mainClass>

        <!-- =====================================================
             JaCoCo Configuration
             ===================================================== -->

        <jacoco.version>
            0.8.13
        </jacoco.version>

        <!-- =====================================================
             OWASP Dependency-Check Configuration
             ===================================================== -->

        <dependency.check.version>
            13.0.0
        </dependency.check.version>

        <!-- =====================================================
             Security Remediation Dependency Versions
             ===================================================== -->

        <jasperreports.version>
            6.21.5
        </jasperreports.version>

        <jackson.version>
            2.18.11
        </jackson.version>

        <log4j.version>
            2.25.5
        </log4j.version>

        <!-- =====================================================
             SonarQube Cloud Project Identification
             ===================================================== -->

        <sonar.organization>
            ar-aienriquezdev
        </sonar.organization>

        <sonar.projectKey>
            ar-aienriquezdev_MO-IT153-IAS2-S4101-Group8-MotorPHPayrollSystem
        </sonar.projectKey>

        <!--
            Import the JaCoCo XML coverage report generated
            during Maven's verify phase.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>
            target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <!--
            Extend SonarQube analysis to relevant non-Java
            project files stored at the repository root.
        -->
        <sonar.maven.scanAll>
            true
        </sonar.maven.scanAll>

        <!--
            NetBeans-generated Swing form classes are excluded from coverage
            measurement only. SonarQube still analyzes these files for
            reliability, security, maintainability, and duplication.
            Shared application behavior in ui/base and all backend/security
            packages remains included in coverage measurement.
        -->
        <sonar.coverage.exclusions>
            src/main/java/ui/Page*.java,
            src/main/java/util/PasswordBulkMigrate.java
        </sonar.coverage.exclusions>

    </properties>

    <!-- =========================================================
         Additional Maven Repositories
         ========================================================= -->
    <repositories>

        <repository>

            <id>
                jaspersoft-repo
            </id>

            <url>
                https://jaspersoft.jfrog.io/artifactory/third-party-ce-artifacts/
            </url>

        </repository>

    </repositories>

    <!-- =========================================================
         Jackson Dependency Management
         ========================================================= -->
    <dependencyManagement>

        <dependencies>

            <dependency>

                <groupId>
                    com.fasterxml.jackson
                </groupId>

                <artifactId>
                    jackson-bom
                </artifactId>

                <version>
                    ${jackson.version}
                </version>

                <type>
                    pom
                </type>

                <scope>
                    import
                </scope>

            </dependency>

        </dependencies>

    </dependencyManagement>

    <!-- =========================================================
         Project Dependencies
         ========================================================= -->
    <dependencies>

        <!-- JDBC -->
        <dependency>

            <groupId>
                com.mysql
            </groupId>

            <artifactId>
                mysql-connector-j
            </artifactId>

            <version>
                9.3.0
            </version>

        </dependency>

        <!-- JasperReports Core -->
        <dependency>

            <groupId>
                net.sf.jasperreports
            </groupId>

            <artifactId>
                jasperreports
            </artifactId>

            <version>
                ${jasperreports.version}
            </version>

        </dependency>

        <!-- JasperReports Fonts -->
        <dependency>

            <groupId>
                net.sf.jasperreports
            </groupId>

            <artifactId>
                jasperreports-fonts
            </artifactId>

            <version>
                ${jasperreports.version}
            </version>

        </dependency>

        <!-- JasperReports Functions -->
        <dependency>

            <groupId>
                net.sf.jasperreports
            </groupId>

            <artifactId>
                jasperreports-functions
            </artifactId>

            <version>
                ${jasperreports.version}
            </version>

        </dependency>

        <!--
            OpenPDF
            Required for JasperReports PDF export.
        -->
        <dependency>

            <groupId>
                com.github.librepdf
            </groupId>

            <artifactId>
                openpdf
            </artifactId>

            <version>
                1.3.29
            </version>

        </dependency>

        <!-- Jakarta Activation API -->
        <dependency>

            <groupId>
                com.sun.activation
            </groupId>

            <artifactId>
                jakarta.activation
            </artifactId>

            <version>
                2.0.1
            </version>

        </dependency>

        <!--
            JAXB runtime.
            Required explicitly for modern JDK versions.
        -->
        <dependency>

            <groupId>
                org.glassfish.jaxb
            </groupId>

            <artifactId>
                jaxb-runtime
            </artifactId>

            <version>
                3.0.2
            </version>

        </dependency>

        <!-- NetBeans AbsoluteLayout -->
        <dependency>

            <groupId>
                org.netbeans.external
            </groupId>

            <artifactId>
                AbsoluteLayout
            </artifactId>

            <version>
                RELEASE240
            </version>

        </dependency>

        <!-- JUnit 5 -->
        <dependency>

            <groupId>
                org.junit.jupiter
            </groupId>

            <artifactId>
                junit-jupiter
            </artifactId>

            <version>
                5.13.1
            </version>

            <scope>
                test
            </scope>

        </dependency>

        <!-- JCalendar -->
        <dependency>

            <groupId>
                com.toedter
            </groupId>

            <artifactId>
                jcalendar
            </artifactId>

            <version>
                1.4
            </version>

        </dependency>

        <!-- BCrypt Password Hashing -->
        <dependency>

            <groupId>
                org.mindrot
            </groupId>

            <artifactId>
                jbcrypt
            </artifactId>

            <version>
                0.4
            </version>

        </dependency>

        <!-- Log4j2 API -->
        <dependency>

            <groupId>
                org.apache.logging.log4j
            </groupId>

            <artifactId>
                log4j-api
            </artifactId>

            <version>
                ${log4j.version}
            </version>

        </dependency>

        <!-- Log4j2 Core -->
        <dependency>

            <groupId>
                org.apache.logging.log4j
            </groupId>

            <artifactId>
                log4j-core
            </artifactId>

            <version>
                ${log4j.version}
            </version>

        </dependency>

    </dependencies>

    <!-- =========================================================
         Build, Coverage, and Static Analysis Configuration
         ========================================================= -->
    <build>

        <plugins>

            <!-- =================================================
                 JaCoCo Java Code Coverage
                 ================================================= -->

            <plugin>

                <groupId>
                    org.jacoco
                </groupId>

                <artifactId>
                    jacoco-maven-plugin
                </artifactId>

                <version>
                    ${jacoco.version}
                </version>

                <executions>

                    <!--
                        Attach the JaCoCo Java agent before
                        JUnit tests execute.
                    -->
                    <execution>

                        <id>
                            prepare-agent
                        </id>

                        <goals>

                            <goal>
                                prepare-agent
                            </goal>

                        </goals>

                    </execution>

                    <!--
                        Generate JaCoCo HTML, XML, and CSV
                        reports during Maven's verify phase.
                    -->
                    <execution>

                        <id>
                            jacoco-report
                        </id>

                        <phase>
                            verify
                        </phase>

                        <goals>

                            <goal>
                                report
                            </goal>

                        </goals>

                    </execution>

                </executions>

            </plugin>

            <!-- =================================================
                 OWASP Dependency-Check
                 ================================================= -->

            <plugin>

                <groupId>
                    org.owasp
                </groupId>

                <artifactId>
                    dependency-check-maven
                </artifactId>

                <version>
                    ${dependency.check.version}
                </version>

                <configuration>

                    <!--
                        Generate evidence in multiple machine- and
                        human-readable formats.
                    -->
                    <format>
                        ALL
                    </format>

                    <!--
                        Treat High and Critical dependency findings
                        as release-blocking unless they are remediated
                        or formally documented as an exception.
                    -->
                    <failBuildOnCVSS>
                        7.0
                    </failBuildOnCVSS>

                    <outputDirectory>
                        ${project.build.directory}/dependency-check
                    </outputDirectory>

                    <!--
                        Read the NVD API key from the local environment.
                        Only the environment-variable name is stored in Git;
                        the key itself must never be committed.
                    -->
                    <nvdApiKeyEnvironmentVariable>
                        NVD_API_KEY
                    </nvdApiKeyEnvironmentVariable>

                    <suppressionFiles>

                        <suppressionFile>
                            ${project.basedir}/docs/security/dependency-check-suppressions.xml
                        </suppressionFile>

                    </suppressionFiles>

                    <failBuildOnUnusedSuppressionRule>
                        true
                    </failBuildOnUnusedSuppressionRule>

                </configuration>

                <executions>

                    <execution>

                        <id>
                            dependency-security-check
                        </id>

                        <phase>
                            verify
                        </phase>

                        <goals>

                            <goal>
                                check
                            </goal>

                        </goals>

                    </execution>

                </executions>

            </plugin>


            <!-- =================================================
                 SonarQube Cloud Static Analysis
                 ================================================= -->

            <plugin>

                <groupId>
                    org.sonarsource.scanner.maven
                </groupId>

                <artifactId>
                    sonar-maven-plugin
                </artifactId>

                <version>
                    5.5.0.6356
                </version>

            </plugin>

        </plugins>

    </build>


    <!-- =========================================================
         Dedicated Security Regression Test Profile
         ========================================================= -->
    <profiles>

        <profile>

            <id>
                security-regression
            </id>

            <build>

                <plugins>

                    <plugin>

                        <groupId>
                            org.apache.maven.plugins
                        </groupId>

                        <artifactId>
                            maven-surefire-plugin
                        </artifactId>

                        <version>
                            3.2.5
                        </version>

                        <configuration>

                            <includes>

                                <include>
                                    **/Security*Test.java
                                </include>

                            </includes>

                            <failIfNoTests>
                                true
                            </failIfNoTests>

                        </configuration>

                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

    <name>
        MO-IT153-S4101-Group8-MotorPHPayrollSystem
    </name>

</project>
